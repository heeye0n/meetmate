# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)

# openrouter 또는 factchat
LLM_PROVIDER=openrouter
# openrouter 예: deepseek/deepseek-chat-v3.1:free  (무료 모델은 바뀔 수 있으니 openrouter.ai/models 에서 확인)
# factchat 예: claude-haiku-4-5-20251001
LLM_MODEL=deepseek/deepseek-chat-v3.1:free

OPENROUTER_API_KEY=
FACTCHAT_API_KEY=

# GitHub 이슈 등록용 (Step 3). 없으면 체크리스트 복사 기능으로 대체됨
GITHUB_TOKEN=
GITHUB_REPO=heeye0n/MeetMate-demo

# true 면 API 호출 없이 samples/demo_responses/ 의 저장된 응답 사용 (시연 대비)
DEMO_MODE=false
